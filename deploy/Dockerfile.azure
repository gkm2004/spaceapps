# Azure Container Apps image with the runtime data baked in (~0.9 GB).
# Build from a staged context holding backend/, frontend/mock/ and data/
# (see deploy/azure-deploy.ps1); data/raw and data/scripts are not needed.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY backend/requirements.lock backend/requirements.lock
RUN pip install -r backend/requirements.lock

COPY backend/ backend/
COPY frontend/mock/ frontend/mock/

ENV DATA_DIR=/data
# Data is split into many layers of ~35 MB or less so a registry push can
# resume after a dropped connection instead of re-sending one ~900 MB layer.
COPY data/waypoints/ /data/waypoints/
COPY data/tiles/ /data/tiles/
COPY data/processed/gale_cost.npy data/processed/gale_slope.npy /data/processed/
COPY data/processed/jezero_cost.npy data/processed/jezero_slope.npy /data/processed/
COPY data/processed/gale_dem.tif data/processed/gale_dem_1m.tif data/processed/gale_grid.json /data/processed/
COPY data/processed/jezero_dem.tif data/processed/jezero_dem_1m.tif data/processed/jezero_grid.json /data/processed/

COPY data/terrain/gale/tileset.json data/terrain/gale/heights.bin data/terrain/gale/L0_* data/terrain/gale/L1_* data/terrain/gale/L2_* /data/terrain/gale/
COPY data/terrain/gale/L3_0_* data/terrain/gale/L3_1_* data/terrain/gale/L3_2_* /data/terrain/gale/
COPY data/terrain/gale/L3_3_* data/terrain/gale/L3_4_* data/terrain/gale/L3_5_* /data/terrain/gale/
COPY data/terrain/gale/L3_6_* data/terrain/gale/L3_7_* data/terrain/gale/L3_8_* /data/terrain/gale/
COPY data/terrain/gale/L3_9_* data/terrain/gale/L3_10_* data/terrain/gale/L3_11_* /data/terrain/gale/

COPY data/terrain/jezero/tileset.json data/terrain/jezero/heights.bin data/terrain/jezero/L0_* data/terrain/jezero/L1_* data/terrain/jezero/L2_* /data/terrain/jezero/
COPY data/terrain/jezero/L3_0_* data/terrain/jezero/L3_1_* data/terrain/jezero/L3_2_* /data/terrain/jezero/
COPY data/terrain/jezero/L3_3_* data/terrain/jezero/L3_4_* data/terrain/jezero/L3_5_* /data/terrain/jezero/
COPY data/terrain/jezero/L3_6_* data/terrain/jezero/L3_7_* data/terrain/jezero/L3_8_* /data/terrain/jezero/
COPY data/terrain/jezero/L3_9_* data/terrain/jezero/L3_10_* data/terrain/jezero/L3_11_* /data/terrain/jezero/

# rasterio's wheels need libexpat, which python:slim lacks
RUN apt-get update && apt-get install -y --no-install-recommends libexpat1 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --system --no-create-home app
USER app

WORKDIR /app/backend
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
  CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/health')"

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
